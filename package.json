{
  "name": "preferred-store",
  "version": "1.0.0",
  "private": true,
  "description": "优选商城 - React19 + Express 全栈电商系统",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "seed": "tsx server/seed.ts",
    "dev": "concurrently -n server,client -c blue,green \"tsx watch server/index.ts\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "test": "node --import tsx --test server/test/*.test.ts",
    "typecheck": "tsc --noEmit -p server && tsc --noEmit -p client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
