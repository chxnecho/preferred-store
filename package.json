{
  "name": "preferred-store",
  "version": "1.0.0",
  "private": true,
  "description": "优选商城 - Vue3 + Express 全栈电商系统",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "seed": "node server/seed.js",
    "dev": "concurrently -n server,client -c blue,green \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "test": "node --test server/test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
